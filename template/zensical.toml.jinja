[project]
site_name = "{{ app_name }}"
site_description = "{{ app_description }}"
site_url = "{{ docs_url }}"
# fbt gathers `*.c*` and `ufbt lint` rejects folders such as `quick-start`; both skip dot-folders.
site_dir = ".site"
repo_url = "{{ app_weburl }}"
copyright = """
{% if license == 'other' %}{{ license_other }}{% else %}<a href="{{ app_weburl }}/blob/develop/LICENSE">{{ license }}</a>{% endif %}.
Copyright (C) {{ copyright_year }} {{ app_author | e }}.
"""

nav = [
  { "Home" = "index.md" },
  { "Development" = [
    { "Toolchain" = "development/toolchain.md" },
    { "Build and run" = "development/build-and-run.md" },
    { "Host tests" = "development/host-tests.md" },
    { "CLion" = "development/clion.md" },
    { "Debug probe" = "development/debug-probe.md" },
    { "Debugging" = "development/debugging.md" },
  ] },
  { "Contributing" = [
    { "Workflow" = "contributing/workflow.md" },
    { "Hooks and CI" = "contributing/hooks-and-ci.md" },
    { "Release" = "contributing/release.md" },
  ] },
]

[project.theme]
variant = "modern"
custom_dir = "docs/templates"
language = "en"
# Off, so a page calls no Google Fonts.
font = false
features = [
  "content.code.copy",
  "navigation.instant",
  "search.highlight",
]

[[project.theme.palette]]
media = "(prefers-color-scheme: light)"
scheme = "default"
toggle.icon = "lucide/sun"
toggle.name = "Switch to dark mode"

[[project.theme.palette]]
media = "(prefers-color-scheme: dark)"
scheme = "slate"
toggle.icon = "lucide/moon"
toggle.name = "Switch to light mode"

[project.plugins.llmstxt]
markdown_description = "{{ app_description }}"
full_output = "llms-full.txt"

[project.plugins.llmstxt.sections]
Start = ["index.md"]
Development = [
  "development/toolchain.md",
  "development/build-and-run.md",
  "development/host-tests.md",
  "development/clion.md",
  "development/debug-probe.md",
  "development/debugging.md",
]
Contributing = [
  "contributing/workflow.md",
  "contributing/hooks-and-ci.md",
  "contributing/release.md",
]

[project.markdown_extensions]
admonition = {}
attr_list = {}
tables = {}
toc.permalink = true
pymdownx.highlight = {}
# Without the Mermaid fence, which the theme renders from a CDN.
pymdownx.superfences = {}
