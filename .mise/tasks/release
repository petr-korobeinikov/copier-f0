#!/bin/sh
#MISE description="Commit the changelog of the next release on main, tag it and push both to origin"
set -eu

refuse() {
    echo "release: $1" >&2
    exit 1
}

[ $# -eq 0 ] || refuse "usage: mise run release"

cd "$(git rev-parse --show-toplevel)"

branch=$(git symbolic-ref --short -q HEAD || true)
[ "$branch" = main ] || refuse "run it on main, not ${branch:-a detached HEAD}"
[ -z "$(git status --porcelain)" ] || refuse "the worktree is not clean"

git fetch -q --tags origin
# Only a pushed commit has been through CI.
[ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || refuse "main differs from origin/main"

released=$(git tag --points-at HEAD --list 'v*' | head -n 1)
[ -z "$released" ] || refuse "main is already $released"

# One call to date, so the year and the month cannot straddle New Year's midnight; no leading
# zero in the month keeps the name valid SemVer.
month=$(date -u +%Y.%-m)
highest=$(git tag --list "v$month.*" | sed "s/^v$month\.//" | grep -Ex '0|[1-9][0-9]*' | sort -n | tail -n 1)
if [ -z "$highest" ]; then
    name=$month.0
else
    name=$month.$((highest + 1))
fi

base=$(git rev-parse HEAD)
# The tree was clean, so this drops only the run's own writes; a commit or a tag left behind
# would make the next run refuse main.
undo() {
    status=$?
    git tag -d "v$name" > /dev/null 2>&1 || true
    git reset -q --hard "$base"
    git clean -fq -- CHANGELOG.md
    echo "release: v$name is undone" >&2
    exit "$status"
}
trap undo EXIT
trap 'exit 1' HUP INT TERM

git-cliff --tag "v$name" --output CHANGELOG.md
git add CHANGELOG.md
git commit -q -S -m "chore: release $name"
git tag -s -m "v$name" "v$name"
# Atomic, so origin gets the commit and the tag together or neither.
git push -q --atomic origin main "refs/tags/v$name"

trap - EXIT
echo "release: v$name is pushed"
